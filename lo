    <script>
        const AdminPanelDirectory = "/admin";

        mainInit();
        const alertsContainer = {
            1 : document.querySelector('#forgotForm .alerts'),
            2 : document.querySelector('#codeAuthForm .alerts'),
            3 : document.querySelector('#changePassForm .alerts')
        }
        const forms = {
            1 : document.querySelector('#forgotForm'),
            2 : document.querySelector('#codeAuthForm'),
            3 : document.querySelector('#changePassForm')
        }
        // Define alert messages
        const alertMessages = {
            201: pageInfo.i18n.Captcha_Error,
            203: pageInfo.i18n.Wrong_Code,
            303: pageInfo.i18n.User_Not_Admin,
            302: pageInfo.i18n.User_Not_Active,
            301: pageInfo.i18n.Wrong_Username_Or_Phone_Or_Email,
            400: pageInfo.i18n.Change_Pass_Successfull,
            204: pageInfo.i18n.Code_Is_Expired,
            401: pageInfo.i18n.Password_Validation_Failed,
            304: pageInfo.i18n.User_Must_Wait
        };

        // Function to create alert message
        function createAlertMessage(message, type = 'danger') {
            return `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>`;a
        }
        
        // Handle different statuses
        switch (pageInfo.status) {
            case 401:
            case 100:
                forms[2]?.remove();
                forms[1]?.remove();
                var  pattern = "^(?=.*[A-z])(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9])" +
                (pageInfo.specialchars === "0" ? "" : "(?=.*[!@#$%^&*()])" ) +
                "\\S{"+pageInfo.passwordlength +",18}$" ;
                document.querySelector("#password").setAttribute("pattern", pattern)
                if (alertMessages[pageInfo.status]) {
                    alertsContainer[3].innerHTML = createAlertMessage(alertMessages[pageInfo.status]);
                }
                break;
            case 304:
            case 204:
            case 200:
            case 203:
                forms[1]?.remove();
                forms[3]?.remove();
                document.querySelector(".resend-code").addEventListener('click', (e) =>{
                    document.querySelector("#codeAuthForm #action").value = "resndcode";
                    document.querySelector("#codeAuthForm #verificationCode").required = false;
                })
                if (alertsContainer && alertMessages[pageInfo.status]) {
                    alertsContainer[2].innerHTML = createAlertMessage(alertMessages[pageInfo.status]);
                }
                break;
            case 400:
                forms[2]?.remove();
                forms[3]?.remove();
                forms[1].innerHTML = `<div style="font-weight: bold;text-align: center;color: #238016;font-size: 16px;line-height: 33px;" class="p-3">${alertMessages[pageInfo.status]}</div>`;
                addEventListener("DOMContentLoaded", (event) => {setTimeout(() => {window.location = getUrlBeforeKeyword(String(window.location), 'passwordrecovery')}, 5000);});
            
            default:
                forms[2]?.remove();
                forms[3]?.remove();
                if (alertMessages[pageInfo.status]) {
                    alertsContainer[1].innerHTML = createAlertMessage(alertMessages[pageInfo.status]);
                }
                break;
        }

        // Countdown timer
        const startingSeconds = 120;
        let time = startingSeconds;
        const countdownEl = document.getElementById('countdown');

        // Start countdown timer if countdown element exists
        if (countdownEl) {
            let timerInterval = setInterval(updateCountdown, 1000);
            if(pageInfo.status == 204){
                    clearInterval(timerInterval);
                    document.querySelector("#countdown").innerHTML = "0:00";
                    // Enable resend code button or handle timeout logic
                    const resendCodeButton = document.querySelector(".resend-code");
                    if (resendCodeButton) {
                        resendCodeButton.disabled = false;
                    }
            }
            function updateCountdown() {
                const minutes = Math.floor(time / 60);
                let seconds = time % 60;
                seconds = seconds < 10 ? '0' + seconds : seconds; // Add leading zero if seconds is less than 10
                countdownEl.textContent = `${minutes}:${seconds}`;
                if (time <= 0) {
                    clearInterval(timerInterval);
                    // Enable resend code button or handle timeout logic
                    const resendCodeButton = document.querySelector(".resend-code");
                    if (resendCodeButton) {
                        resendCodeButton.disabled = false;
                    }
                } else {
                    time--;
                }
            }
        }

        function getUrlBeforeKeyword(url, keyword) {
            if (!url) {
                url = window.location.href; 
            }
            if (!keyword) {
                return null; 
            }

            const position = url.indexOf(keyword);

            // If the keyword is found, return the part before it
            if (position !== -1) {
                return url.substring(0, position);
            } else {
                return null; // If the keyword is not found, return null
            }
            }
    </script>
