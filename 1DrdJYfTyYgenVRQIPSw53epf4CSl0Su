function codeForm() {
	var passwordText = document.querySelector("#user-password-text");
	var password = document.querySelector("#user-password");
	password.value = passwordText.value;
	if (password.value == passwordText.value) {
		password.value = $.Base64_encode(passwordText.value);
	}
}
