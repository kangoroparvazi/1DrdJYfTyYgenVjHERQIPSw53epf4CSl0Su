jQuery.disableTahririe = function (act = true) {
    var panels = ["#newsbody", "#newsfiles", "#newsgroups", "#newsseo", "#newsrelated", "#newssettings", "#messengers", "#newspoint", "#newspositionplc", "#newssend"];
    var selector = ["input", "select", "button[type='button']", "textarea"];
    for (let i = 0; i < panels.length; i++) {
        for (let k = 0; k < selector.length; k++) {
            if (act) {
                $(panels[i]).css({
                    "position": "relative"
                }).append('<div class="blocker"></div>')
            } else {
                $(".blocker").remove();
            }
            $(panels[i] + " " + selector[k]).each((index, item) => {
                if ($(item).data("important-not-enabled")) return

                $(item).attr("disabled", act);
                //console.log($(item).data("important-not-enabled"));
            })

        }
    }

    let tinyMCEInterValChecker = setInterval(() => {
        if (tinymce.activeEditor != null && tinymce.activeEditor.getBody() != null) {
            (act ?
                tinymce.activeEditor.getBody().setAttribute('contenteditable', false) :
                tinymce.activeEditor.getBody().setAttribute('contenteditable', true)
            )
            clearInterval(tinyMCEInterValChecker)
        }
    }, 500)

}
