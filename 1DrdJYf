// Function to replace or reverse quotes with proper escaping for Unicode
function processQuotes(inputValue, mode = 'replace') {
    if (mode === 'replace') {
        // Replace all single quotes with Unicode \u2019
        return inputValue.replace(/'/g, '&#39;');
    } else if (mode === 'reverse') {
        // Replace all Unicode \u2019 with single quotes
        return inputValue.replace(/&#39;/g, '\'');
    } else {
        throw new Error("Invalid mode specified. Use 'replace' or 'reverse'.");
    }
}

function setTheme(mode) {
    localStorage.setItem('theme', mode);
    applyTheme(mode);
}

function applyTheme(mode) {
    document.body.classList.remove('light-theme', 'dark-theme');
    document.body.classList.add(`${mode}-theme`);

    // update visible selected text (optional)
    const label = document.querySelector('.selected-theme');
    if (label) label.textContent = mode.charAt(0).toUpperCase() + mode.slice(1);
}

