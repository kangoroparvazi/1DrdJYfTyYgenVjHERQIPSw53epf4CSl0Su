jQuery.fn.getFormParams = function (params = {}, values = {}) {
    //this method find all Element Cat cath from input function;.

    $(this).each(function () {
        if ($(this).attr("name") == undefined) return;
        let tagName = (($(this).prop("tagName") == "INPUT") ? $(this).attr("type") : $(this).prop("tagName")).toUpperCase();
        if ($(this).attr("disabled") == "disabled" && typeof values[$(this).attr("name")] != "undefined") {
            console.log(values, $(this).attr("name"), values[$(this).attr("name")])
            params[$(this).attr("name")] = values[$(this).attr("name")];
            return;
        }
        switch (tagName) {
            case ("TEXT"):
                params[$(this).attr("name")] = $.Base64_encode($(this).val());

                break;
            case ("RANGE"):
                params[$(this).attr("name")] = $.Base64_encode($(this).val());
                break;
            case ("COLOR"):
                params[$(this).attr("name")] = $.Base64_encode($(this).val());
                break;
            case ("HIDDEN"):
                params[$(this).attr("name")] = $.Base64_encode($(this).val());
                break;
            case ("TEL"):
                params[$(this).attr("name")] = $.Base64_encode($(this).val());
                break;
            case ("EMAIL"):
                params[$(this).attr("name")] = $.Base64_encode($(this).val());
                break;
            case ("PASSWORD"):
                params[$(this).attr("name")] = $.Base64_encode($(this).val());
                break;
            case ("CHECKBOX"):
                let checkBoxTest = false;

                params[$(this).attr("name")] = ($(this).prop("checked") ? 1 : 0);
                break;
            case ("SELECT"):
                let tempValue = ($(this).val() == null ? "" : $(this).val());
                params[$(this).attr("name")] = (typeof tempValue == "string" ? tempValue : tempValue.join(","));
                break;
            case ("TIME"):
                params[$(this).attr("name")] = $(this).val();
                break;
            case ("TEXTAREA"):
                if ($(this).hasClass("codemirror")) {
                    params[$(this).attr("name")] = $.Base64_encode($.getCodeMirrorNative("#" + $(this).attr("name")).getValue())
                } else if ($(this).hasClass("tinymce")) {

                    params[$(this).attr("name")] = $.Base64_encode(tinyMCE.get($(this).attr("id")).getContent());
                } else {
                    params[$(this).attr("name")] = $.Base64_encode($(this).val());
                }
                break;
            case ("DIV"):
                if ($(this).hasClass("file-uploader-data")) {
                    if ($(this).find("figure:not(.deleted)").length == 1)
                        params[$(this).attr("name")] = $(this).find("figure:not(.deleted)").data("id");
                    else {
                        var res = [];
                        $(this).find("figure:not(.deleted)").each(function () {
                            res.push($(this).data("id"));
                        });
                        params[$(this).attr("name")] = res.join(",");
                    }
                }
                break;
            default:
                console.log("getFormParams.Switch:Case not found");

        }
        //    , $(this).attr("class") );
    });
    return params;
}
