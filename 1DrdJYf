jQuery.fn.searchText = function (opt) {
    if (typeof opt == "undefined" || typeof opt.findElem == "undefined") {
        console.log("SearchText:findElem option not found(Scripts.js)");
        return false
    }
    $(this).on("keyup change paste", function () {
        var text = $(this).val()
            .toLowerCase()
            .replace(/ي/g, "ی"),
            cnt = 0;
        // console.log(text);
        $(opt.findElem).addClass("d-none");
        $(opt.findElem).each(function () {
            var TextFind = $(this).text()
                .toLowerCase()
                .replace(/ي/g, "ی"),
                domainText = $(this).attr("data-domain") || "";
            if (TextFind.indexOf(text) >= 0 || domainText.indexOf(text) >= 0) {
                $(this).removeClass("d-none");
                cnt++;
            }
        });
        if (cnt == 0 && $(".search-text-no-found").length == 0) {
            $(opt.findElem).parent("*").append('<span class="dropdown-item  search-text-no-found">Not Found...</span>');
        } else if (cnt > 0) {
            $(".search-text-no-found").remove();
        }
    })

    return this;
}
//get Param With Key
jQuery.getPWK = function (j, key, value, param) {
    //array  - key for find - value for find- get value for param
    //j = the array we want find  
    //param === * (all item as object)
    //param === # index of item in array
    var res;
    j.map(function (el, index) {
        if (param === "*") {
            if ($.CHDB64(el[key]) == $.CHDB64(value)) res = el;
        } else if (param === "#") {
            if ($.CHDB64(el[key]) == $.CHDB64(value)) res = index;
        } else {
            if ($.CHDB64(el[key]) == $.CHDB64(value)) res = el[param]
        }
    });
    return res;
}
