//Check And Decode Base64 and decode it 
$.CHDB64 = function (str) {
    str = (typeof str == "undefined" || str == null ? "" : str.toString()).trim();
    var out = (str.indexOf("B64:") == 0 ? Base64.decode(str.replace("B64:", "")) : str);
    out = (out.indexOf("Base64") == 0 ? Base64.decode(out.replace("Base64", "")) : out);
    return out;
}
$.Base64_decode = function (elem) {
    if (typeof Base64 == "undefined") {
        console.log("Base64 undefined");
        return false;
    } else {
        return Base64.decode(elem.replace("B64:", ""));
    }
}
$.Base64_encode = function (elem) {
    if (typeof Base64 == "undefined") {
