                    ($(this).attr("href") != undefined) ? $(this).attr("href") : $(this).attr("action")
                )
            )
        ) {
            ($(this).attr("href") != undefined && $(this).attr("href").indexOf("#") < 0 && $(this).attr("href").indexOf("http") < 0) ?
            $(this).attr("href", $(this).attr("href") + (($(this).attr("href").indexOf("?") >= 0) ? "&" : "?") + "csrf=" + pageInfo.csrf): $(this).attr("action", $(this).attr("action") /*+ (($(this).attr("action").indexOf("?") >= 0) ? "&" : "?") + "csrf=" + pageInfo.csrf */ );
        }
    })
    //Translate All Text Than Have $$;
    //$.getTranslate();
    $("*").each(function () {
        var text = '';
        for (var i = 0; i < this.childNodes.length; ++i)
            if (this.childNodes[i].nodeType === Node.TEXT_NODE)
                text += this.childNodes[i].textContent;

        if (text.trim().search("$") == 0) return;

        var text = $(this).justText().trim().replace(/\n/g, "");
        if (text.indexOf("$") == 0 && text.substring(text.length - 1) == "$") {
            $(this).html($(this).html().replace(text,
                ((typeof pageInfo.i18n[text.replace(/\$/g, "")] != "undefined") ? pageInfo.i18n[text.replace(/\$/g, "")] : /* "No_Head:" + */ text.replace(/[\$_]/g, " "))
            ));
        }
    });

    $("input,select,textarea,*[placeholder],*[data-on-label],*[data-off-label]").each(function () {
        var $target = $(this);
        $.each(this.attributes, function () {
            var dollaRegex = new RegExp(/\$[a-z,A-Z,0-9,_]\S+\$/gu);
            var value = this.value;
            var attr = this.name;
            if (dollaRegex.test(this.value)) {
                var traslated = pageInfo.i18n[this.value.replace(/\$/g, "")] || this.value.replace(/\$/g, "").replace("_", " ")
                $target.attr(attr, traslated)
            }
        });
    });


}

