jQuery.renderMustache = function ($opt) {
    var allMustache = $opt.html.match(/\{\s*[\w\.]+\s*}/g),
        html = $opt.html;
    if (allMustache != null)
        allMustache.map(matchElem => {
            var replaceMent = $opt[/[a-z,A-Z,0-9,_]+/g.exec(matchElem)[0]];
            if (typeof replaceMent != "undefined") {
                html = html.replace(matchElem, replaceMent)
            }
        })
    if ($opt.html.match(/\{\s*[\w\.]+\s*}/g) == null) return html;
    else return this.renderMustache($.extend($opt, {
        html: html
    }))
}
