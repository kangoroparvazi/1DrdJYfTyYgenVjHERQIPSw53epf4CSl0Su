}

function convertTextToTimeInterval(text) {
    const textSplited = text.split(' ');
    var out = {
        "year": 0,
        "month": 0,
        "day": 0
    };
    textSplited.forEach(function (item) {
        if (item.indexOf("d") >= 0) {
            out["day"] += Number(item.replace(/[a-zA-Z]/g, ""));
        } else if (item.indexOf("w") >= 0) {
            out["day"] += Number(item.replace(/[a-zA-Z]/g, "")) * 7;
        } else if (item.indexOf("m") >= 0) {

            out["month"] += Number(item.replace(/[a-zA-Z]/g, ""));
        } else if (item.indexOf("y") >= 0) {
            out["year"] += Number(item.replace(/[a-zA-Z]/g, ""));
        }
    })

    return out
}
