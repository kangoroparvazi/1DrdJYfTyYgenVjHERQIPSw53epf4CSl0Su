        }
        thisDate = dateTemp;
    }
    //End Fixing Safari Date Problem
    miliSecDiff = (new Date(thisDate).getTime() - new Date().getTime()),
        dayDiff = Math.round(miliSecDiff / (60 * 60 * 24 * 1000));
    console.log(dateTemp)
